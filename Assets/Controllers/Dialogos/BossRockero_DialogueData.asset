  beforeItemSlides:
  - dialogueText: "Qu\xE9 pasa tron! "
    showChoices: 0
  - dialogueText: "Si quieres mi sello, tendr\xE1s que batirte en duelo con mi reina
      del baile"
    showChoices: 0
  - dialogueText: "Te espero aqu\xED hasta que no consigas derrotarla y posees la
      guitarra legendaria"
    showChoices: 0
  afterItemSlides:
  - dialogueText: "Sab\xEDa que ten\xEDas algo especial!  Pero si quieres llevar
      la corona del ritmo, tendr\xE1s que gan\xE1rtela bailando.\r\n"
    showChoices: 0
  - dialogueText: "\xA1Sube al escenario y ens\xE9\xF1ame lo que tienes, fen\xF3meno!\"\r\n"
    showChoices: 1
