  npcID: 7
  beforeItemSlides:
  - dialogueText: "\xA1Ufff...! No puedo..."
    showChoices: 0
  - dialogueText: "Estoy mazo rallado, hermano. Me vibra el alma al rev\xE9s."
    showChoices: 0
  - dialogueText: "\xBFHas visto mi puchito de la paz? Sin \xE9l, no soy nadie..."
    showChoices: 0
  - dialogueText: "Enserio, t\xEDo... Cons\xEDgueme uno y hablamos..."
    showChoices: 0
  afterItemSlides:
  - dialogueText: "\xA1Ohhhhh hermano...! \xA1Qu\xE9 bendici\xF3n!"
    showChoices: 0
  - dialogueText: "Esto s\xED que es buena vibra. Ahora siento que floto sobre la
      arena..."
    showChoices: 0
  - dialogueText: "Eres un alma noble, t\xEDo. Gracias por esto."
    showChoices: 0
  - dialogueText: "Ya que estamos tan en sinton\xEDa... \xBFpor qu\xE9 no lo resolvemos
      como los grandes?"
    showChoices: 0
  - dialogueText: "T\xFA y yo... un duelo de ritmo... a la luz del sol. "
    showChoices: 1
