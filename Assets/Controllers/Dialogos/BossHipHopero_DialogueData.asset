  beforeItemSlides:
  - dialogueText: "\xA1Ni me mires!"
    showChoices: 0
  - dialogueText: "Estoy buscando mi cadena de oro tronco, que me la regal\xF3 mi
      yaya\r\n"
    showChoices: 0
  - dialogueText: "\xA1Alg\xFAn joputa me la ha robao seguro!\r\n"
    showChoices: 0
  - dialogueText: ...
    showChoices: 0
  - dialogueText: "\xA1\xA1QUE TE PIRES JODER!!\r\n"
    showChoices: 0
  afterItemSlides:
  - dialogueText: "Qu\xE9 pasa tronco!\r\n"
    showChoices: 0
  - dialogueText: 'Veo que ya has encontrado mi "Bling -Bling". Cuando te he visto,
      no apostaba un duro por ti.

'
    showChoices: 0
  - dialogueText: 'Pero veo que tienes sangre callejera tronco.

'
    showChoices: 0
  - dialogueText: "\xBFQuieres que nos retemos a un duelo de ritmo?\r\n"
    showChoices: 1
